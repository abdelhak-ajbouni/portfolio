---
import TopBar from "src/components/TopBar.astro";
import "../styles/global.css";

export interface Props {
  title: string;
}

const { title } = Astro.props;
const url = 'https://abdelhak-ajbouni.com';
const id = "G-EL8M9BZFR5";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth font-mono">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Abdelhak Ajbouni — senior React and React Native developer in Luxembourg. Explore my web and mobile apps, built with TypeScript."
    />
    <meta name="author" content="Abdelhak Ajbouni" />
    <meta
      name="google-site-verification"
      content="JMmrRR7yjGerSDAcdTftzDRJohfk6t9fcc-ljfJbHqM"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Abdelhak Ajbouni — senior React and React Native developer in Luxembourg. Explore my web and mobile apps, built with TypeScript." />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Abdelhak Ajbouni — senior React and React Native developer in Luxembourg. Explore my web and mobile apps, built with TypeScript." />
    <title>{title}</title>
  </head>
  <body class="bg-slate-700">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <TopBar />
    <slot />

    <!-- Google tag (gtag.js) -->
    <script
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-EL8M9BZFR5"
    ></script>
    <script type="text/partytown" defer is:inline define:vars={{ id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", id);
    </script>

    <!-- Fix Partytown iframe accessibility -->
    <script is:inline>
      // Add title attribute to Partytown iframe for accessibility
      const observer = new MutationObserver(() => {
        const iframe = document.querySelector('iframe[src*="partytown"]');
        if (iframe && !iframe.hasAttribute('title')) {
          iframe.setAttribute('title', 'Partytown Web Worker for Analytics');
          observer.disconnect();
        }
      });
      observer.observe(document.documentElement, { childList: true, subtree: true });
    </script>
  </body>
</html>
