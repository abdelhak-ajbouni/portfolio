---
import { Image } from "astro:assets";
import Container from "src/components/common/Container.astro";
const navLink = "nav-link inline-flex items-center justify-center text-gray-200 font-bold py-2 px-2 md:px-4 rounded text-sm md:text-base underline-offset-4 decoration-2 hover:underline";
---

<Container className="top-bar flex justify-between items-center gap-2 py-2 md:py-4">
  <a href="/" class="shrink-0" aria-label="Abdelhak Ajbouni home">
    <Image class="w-8 h-8 md:w-10 md:h-10" src="/favicon.svg" height={40} width={40} alt="Abdelhak Ajbouni logo" />
  </a>
  <nav class="flex justify-end items-center" aria-label="Main navigation">
    <a class={navLink} href="/#about">About</a>
    <a class={navLink} href="/#projects">Projects</a>
    <a class={navLink} href="/#contact">Contact</a>
    <a class="nav-link inline-flex items-center justify-center ml-2 md:ml-4 font-bold py-2 px-2 md:px-4 rounded text-sm md:text-base text-white bg-purple-700 hover:bg-purple-600" href="/files/resume-abdelhak-ajbouni.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
  </nav>
</Container>
