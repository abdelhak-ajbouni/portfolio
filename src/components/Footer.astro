---
import Container from "src/components/common/Container.astro";
import Divider from "src/components/common/Divider.astro";
import Connections from "./Connections.astro";
---

<Divider />
<Container className="py-4 flex flex-wrap gap-x-3 gap-y-2 md:justify-end items-center">
  <Connections />
  <div class="flex">
    <p class="text-xs md:text-sm md:mx-1 text-gray-300">
      Made By Abdelhak Ajbouni
    </p>
    <p class="text-xs md:text-sm mx-1 text-gray-300">
      ©{new Date().getFullYear()}
    </p>
  </div>

  <p class="text-xs md:text-sm md:mx-2 text-gray-300 hidden md:block">|</p>
  <p class="text-xs md:text-sm md:mx-1 text-gray-300">
    built with <a
      class="text-pink-400 hover:text-pink-300"
      href="https://astro.build"
      target="_blank" rel="noopener noreferrer">Astro</a
    >
  </p>
</Container>
